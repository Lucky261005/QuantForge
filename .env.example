# Copy this file to .env and adjust as needed. docker-compose.yml reads from .env automatically.

# --- App ---
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Postgres (used by docker-compose; backend connects via DATABASE_URL below) ---
POSTGRES_USER=quantforge
POSTGRES_PASSWORD=quantforge
POSTGRES_DB=quantforge
DATABASE_URL=postgresql://quantforge:quantforge@postgres:5432/quantforge

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Frontend URL used in emailed links; dev emails are written to backend/dev_outbox/ ---
FRONTEND_URL=http://localhost:3000

# --- CORS (frontend origin) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost"]

# --- Optional market data providers (leave blank to use Yahoo Finance / CSV / NSE official only) ---
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
KITE_API_KEY=
KITE_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_ONE_API_KEY=
ANGEL_ONE_JWT_TOKEN=
ANGEL_ONE_CLIENT_CODE=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost/api/v1
